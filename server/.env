# StoreX Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Pluggable Database Driver: "memory" | "supabase" | "mongodb" | "mysql"
DB_DRIVER=memory

# --- Supabase Configuration (Optional - When DB_DRIVER=supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- MongoDB Configuration (Optional - When DB_DRIVER=mongodb) ---
MONGODB_URI=mongodb://localhost:27017/storex

# --- MySQL Configuration (Optional - When DB_DRIVER=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=storex
